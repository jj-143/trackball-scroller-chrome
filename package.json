{
  "name": "trackball-scroller",
  "version": "2.2.0",
  "description": "Trackball Scroller for Chrome",
  "scripts": {
    "build": "tsx scripts/build.ts",
    "dev": "tsx scripts/build.ts --watch --dev",
    "e2e": "cypress run --headed",
    "test": "jest --config=./jest.config.js",
    "test:watch": "jest --watch --config=./jest.config.js",
    "test:e2e": "concurrently -k npm:dev npm:e2e",
    "cypress": "cypress open",
    "screenshot": "cypress run --headed --spec cypress/utils/screenshot.cy.ts --config-file cypress/utils/cypress.config.ts"
  },
  "dependencies": {
    "preact": "^10.27.2"
  },
  "devDependencies": {
    "@preact/preset-vite": "^2.10.2",
    "@types/chrome": "^0.0.236",
    "@types/jest": "^26.0.0",
    "@typescript-eslint/eslint-plugin": "^5.55.0",
    "@typescript-eslint/parser": "^5.55.0",
    "clsx": "^2.1.1",
    "concurrently": "^8.0.1",
    "cypress": "^14.4.0",
    "cypress-real-events": "^1.14.0",
    "eslint": "^8.36.0",
    "jest": "^29.5.0",
    "jest-environment-jsdom": "^29.5.0",
    "sass": "^1.93.2",
    "ts-jest": "^29.4.4",
    "tsx": "^4.20.6",
    "typescript": "^5.9.2",
    "vite": "^7.1.9",
    "vite-tsconfig-paths": "^5.1.4",
    "wait-for-expect": "^3.0.2"
  },
  "repository": "https://github.com/jj-143/trackball-scroller-chrome",
  "author": "<jj.dev.001@gmail.com>",
  "license": "MIT"
}
