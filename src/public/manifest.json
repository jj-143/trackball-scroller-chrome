{
  "name": "Trackball Scroller",
  "version": "2.2.0",
  "version_name": "2.2.0",
  "description": "Scroll with your trackball",
  "permissions": [
    "storage"
  ],
  "background": {
    "service_worker": "/background/background.bundle.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "/inject/inject.bundle.js"
      ],
      "all_frames": true
    }
  ],
  "action": {},
  "icons": {
    "128": "/assets/icon.png"
  },
  "options_ui": {
    "page": "/options/index.html",
    "open_in_tab": true
  },
  "manifest_version": 3
}